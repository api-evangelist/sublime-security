{
  "opencollection": "1.0.0",
  "info": {
    "name": "Multi-Tenancy API (BETA) BinExplode Live flow API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Live flow",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Process raw message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{scheme}://{server}/v0/live-flow/raw-messages/analyze",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Process a raw message"
        }
      ]
    }
  ],
  "bundled": true
}