{
  "opencollection": "1.0.0",
  "info": {
    "name": "Multi-Tenancy API (BETA) BinExplode Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{scheme}://{server}/v0/tasks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ]
          },
          "docs": "Retrieve a task"
        }
      ]
    }
  ],
  "bundled": true
}